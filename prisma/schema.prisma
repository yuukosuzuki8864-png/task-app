// prisma/schema.prisma（ファイルを丸ごと置き換え）
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// タスクの状態は3つだけ
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}
 
model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  userId      String   @map("user_id")
  insertedAt  DateTime @map("inserted_at") @default(now())
updatedAt DateTime @updatedAt @default(now()) @map("updated_at")
  categoryId  Int?     @map("category_id")

  @@index([userId])
}


model Category {
  id    BigInt @id @default(autoincrement())
  name  String

  @@map("categories")
}