// prisma/schema.prisma（ファイルを丸ごと置き換え）
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// タスクの状態は3つだけ
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}


 
model Task {
  id         BigInt     @id @default(autoincrement())
  title      String
  status     TaskStatus
  userId     String?    @map("user_id")
  insertedAt DateTime   @map("inserted_at") @default(now())
  categoryId BigInt?    @map("category_id")

  @@map("todos")
}



model Category {
  id    BigInt @id @default(autoincrement())
  name  String

  @@map("categories")
}