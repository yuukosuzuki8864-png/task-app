// prisma/schema.prisma（ファイルを丸ごと置き換え）
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// タスクの状態は3つだけ
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}


model Task {
  id          BigInt   @id @default(autoincrement())
  task        String
  isComplete  Boolean  @map("is_complete")
  userId      String?  @map("user_id")
  insertedAt  DateTime @map("inserted_at")
  categoryId  BigInt?  @map("category_id")

  @@map("todos")
}

model Category {
  id    BigInt @id @default(autoincrement())
  name  String

  @@map("categories")
}